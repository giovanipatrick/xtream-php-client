{
    "name": "giovanipatrick/xtream-php-client",
    "description": "A PHP 7.0+ client for Xtream-compatible IPTV Player APIs.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "xtream",
        "xtream-codes",
        "iptv",
        "player-api",
        "epg",
        "vod"
    ],
    "authors": [
        {
            "name": "Giovani Patrick"
        }
    ],
    "homepage": "https://giovanipatrick.github.io/xtream-php-client/",
    "support": {
        "issues": "https://github.com/giovanipatrick/xtream-php-client/issues",
        "source": "https://github.com/giovanipatrick/xtream-php-client"
    },
    "require": {
        "php": ">=7.0",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^6.5 || ^7.5 || ^8.5 || ^9.6 || ^10.5 || ^11.5 || ^12.0",
        "squizlabs/php_codesniffer": "^3.7 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "Xtream\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Xtream\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs": "phpcs",
        "check": [
            "@cs",
            "@test"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
